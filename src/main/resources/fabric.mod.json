	"authors": [
		"CrossMod Team"
	],
	"contact": {
		"homepage": "https://github.com/qtenish-droid/crossmod",
		"sources": "https://github.com/qtenish-droid/crossmod",
		"issues": "https://github.com/qtenish-droid/crossmod/issues",
		"discord": "https://discord.gg/tDe4cZYyuV"
	},
	"license": "MIT",
	"icon": "assets/crossmod/icon.png",
