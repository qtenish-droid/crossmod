			"io.github.crossmod.client.CrossModClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"discord": "https://discord.gg/tDe4cZYyuV"
